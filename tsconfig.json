{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@bric/rex-web-visits": ["../rex-web-visits/src/index.mts"],
      "@bric/rex-page-events": ["../rex-page-events/src/index.mts"]
    },
    "module": "NodeNext",
    "target": "es5",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "sourceMap": true,
    "outDir": "dist",
    "types": ["chrome"],
    "lib": ["es2015", "es2016", "dom"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ]
}
